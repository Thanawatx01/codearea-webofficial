# Auto-generated by npm run setup:env
# Target: frontend/.env.local
# Active vars below are required or intentionally customized for local development.

# Frontend routing
# Backend API base URL.
# Frontend requests break without this in normal local setup.
NEXT_PUBLIC_API_URL=http://localhost:3100/api

# Runtime already defaults to CodeArea.
NEXT_PUBLIC_APP_NAME=CodeArea

# Runtime already defaults to local frontend URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Frontend optional integrations
# Optional separate AI service URL.
# If omitted, AI requests fall back to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_AI_URL=http://127.0.0.1:8000

# Optional asset host override.
NEXT_PUBLIC_UPLOAD_BASE_URL=http://localhost:5000/assets

# Optional defaults skipped for now.
# Uncomment only when you need to override app fallback behavior.
# Optional custom hint endpoint path.
# NEXT_PUBLIC_QUESTION_HINT_PATH=api/hint

# Optional custom code-compare endpoint path.
# NEXT_PUBLIC_QUESTION_COMPARE_PATH=api/compare
