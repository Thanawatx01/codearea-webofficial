# Local development defaults.
# For Vercel production, set these in Project Settings > Environment Variables.

# App Name
NEXT_PUBLIC_APP_NAME=CodeArea

# Frontend Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API — callApi() ฐานปกติ (isAI=false ค่าเริ่มต้น)
NEXT_PUBLIC_API_URL=http://localhost:3100/api
# Production example:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# Optional direct AI URL. Current UI proxies AI through backend `/api/ai-tutor/*`,
# so production usually leaves this unset and configures AI_CONNECTOR_URL in backend.
# NEXT_PUBLIC_AI_URL=https://ai.your-domain.com

# Upload Assets (pointing to backend static folder)
NEXT_PUBLIC_UPLOAD_BASE_URL=http://localhost:3100/assets
# Production example:
# NEXT_PUBLIC_UPLOAD_BASE_URL=https://api.your-domain.com/assets
